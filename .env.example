# 必填：Claude API key
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_MODEL_LIGHT=claude-haiku-5-5
# 设为 1 用模拟回复，不调用 AI（试跑用）
# MOCK_LLM=1

# Postgres 连接串（例如 Neon），不填则数据存在本地 .data 文件夹
# DATABASE_URL=

# 管理员邮箱（逗号分隔）。线上务必设置；不设时「最早注册的账号」是管理员
# ADMIN_EMAILS=
# 你的公开网址，用于机器人里的网页登录链接
# PUBLIC_URL=

# X 官方 API（OAuth 2.0）：在 X 开发者后台创建 App 后填入，详见 README「连接 X」
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# 回调地址，需和开发者后台填的一致；默认 http://127.0.0.1:3000/api/x/callback
# X_REDIRECT_URI=
# 设为 1 时用模拟账号走完连接、发布、回复流程，不会真的发到 X
# X_MOCK=1
# 加密保存 X 令牌用的密钥；本地不填会自动生成在 .data/secret.key，线上部署必须填
# TOKEN_ENCRYPTION_KEY=
# 线上部署时，Cron 调用 /api/cron/tick 需要带 Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# TG 机器人 Token（在 TG 里找 @BotFather 发 /newbot 获得）；也可以在「灵感」页粘贴保存
# TELEGRAM_BOT_TOKEN=
# 线上部署改用 webhook 时设为 1，并设置 TELEGRAM_WEBHOOK_SECRET（至少 16 位随机字符）
# TELEGRAM_WEBHOOK=1
# TELEGRAM_WEBHOOK_SECRET=

# 配图用的 Gemini key（可选）
# GEMINI_API_KEY=
# 数据库每日加密备份的密码（可选）
# BACKUP_PASSPHRASE=

# 前面有几层可信反向代理（默认 1；套了 Cloudflare 再加 Railway 等设成 2）。限流按 x-forwarded-for 从右往左数这么多个
# TRUSTED_PROXY_HOPS=1
